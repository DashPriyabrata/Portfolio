---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full flex flex-col">
    <header class="flex items-center mb-4">
      <h2 class="text-white text-xl font-bold">
        More about me...
      </h2>
    </header>

    <div class="space-y-4">
      <!-- Contact Details -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-darkslate-300">
          Contact Details
        </h3>
        <p class="text-md text-gray-200 mt-1">{SITE.links.email}</p>
        <p class="text-sm text-gray-400">{SITE.location.countryName}</p>
      </div>

      <!-- Socials -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-darkslate-300">
          Socials
        </h3>
        <ul class="flex flex-wrap gap-x-3 gap-y-1 mt-1 text-sm text-gray-300">
          <li>
            <a 
              href={LINKS.linkedin} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a 
              href={LINKS.github} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a 
              href={LINKS.stackoverflow} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              Stack Overflow
            </a>
          </li>
        </ul>
      </div>

      <!-- Education -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-darkslate-300">
          Education
        </h3>
        <p class="text-md font-medium text-gray-200 mt-1">
          M.Tech in Software Engineering
        </p>
        <p class="text-sm text-gray-400"> 
          National University of Singapore (NUS)
        </p>
      </div>
    </div>
  </div>
</Card>