---
// src/components/Photo.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  title: string;
  details?: string;
  alt?: string;
  eager?: boolean;
  // Use "max-h" to cap tall vertical photos (default), or force an aspect ratio crop
  maxHeight?: string; // e.g., "max-h-[450px]", "max-h-[550px]", or "none"
  aspectRatio?: "auto" | "square" | "portrait" | "landscape"
}

const { 
  src, 
  title, 
  details, 
  alt = title, 
  eager = false, 
  maxHeight = "max-h-[480px]",
  aspectRatio = "auto"
} = Astro.props;

// Aspect ratio mappings
const aspectClasses = {
  auto: "",
  square: "aspect-square",
  portrait: "aspect-[3/4]",
  landscape: "aspect-[4/3]",
};

const hasAspect = aspectRatio !== "auto";
---

<button
  type="button"
  class="photo-card-trigger relative group break-inside-avoid rounded-xl overflow-hidden cursor-pointer mb-6 text-left w-full focus:outline-none block bg-neutral-900"
  data-img-src={src.src}
  data-title={title}
  data-details={details || ''}
>
  <!-- Wrapper enforces max height cap or aspect crop -->
  <div class={`relative w-full overflow-hidden ${hasAspect ? aspectClasses[aspectRatio] : maxHeight !== 'none' ? maxHeight : ''}`}>
    <Image
      src={src}
      format="webp"
      quality={80}
      class={`w-full ${hasAspect || maxHeight !== 'none' ? 'h-full object-cover' : 'h-auto'} shadow-lg transition-transform duration-700 group-hover:scale-105 block`}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="auto"
    />
  </div>

  <!-- Hover Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6 z-10 pointer-events-none">
    <h3 class="text-white text-xl font-bold translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
      {title}
    </h3>
    {details && (
      <p class="text-darkslate-300 text-sm mt-1 translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-75">
        {details}
      </p>
    )}
  </div>
</button>