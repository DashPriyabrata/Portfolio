---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import ThemeChangeCard from "../components/ThemeChangeCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
import Globe from "../components/Globe";
import PhotographyCard from "../components/PhotographyCard.astro";
import { SITE } from "../site-config";

const currentYear = new Date().getFullYear();
---

<script>
  import { stagger, animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../lib/constants";
  const cards = document.querySelectorAll(".card");

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      {
        type: "spring",
        at: "-0.1",
        delay: stagger(0.2),
      },
    ],
  ];

  animate(sequence as AnimationSequence);
</script>

<Layout
  description={`Lead Software Engineer based in ${SITE.location.countryName}, designing scalable backend & full‑stack systems, microservices, and LLM‑driven automation using .NET, Node.js, TypeScript, React — open to collaboration.`}
  title={`${SITE.author.fullName} - ${SITE.author.jobTitle} & Solutions Architect`}
>
  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:min-h-screen lg:grid-cols-4 lg:gap-4 lg:max-h-[1200px]"
  >
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <TimeZone />
    <PhotographyCard />
    <Now />

    <Card
      href="/guestbook"
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title="Guestbook"
    >
      {/* The Background Gradient */}
      <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary-500/20 via-transparent to-transparent opacity-80 transition-opacity duration-300 hover:opacity-100"></div>
    </Card>

    <Card
      colSpan="md:col-span-1"
      href="travel"
      rowSpan="md:row-span-2"
      title="Countries I visited"
      body="9 countries so far! A personal record of my travels around the world."
    >
      <!-- Background Globe Container perfectly centered in 2-column space -->
      <div class="h-full w-full absolute inset-0 -z-10 flex items-center justify-center overflow-hidden pointer-events-none opacity-50">
        <div class="hidden md:flex items-center justify-center shrink-0 w-[650px] h-[650px] translate-y-2">
          <Globe client:media="(min-width: 768px)" />
        </div>
        <div class="flex md:hidden items-center justify-center shrink-0 w-[650px] h-[650px]">
          <Globe client:media="(max-width: 768px)" isStatic={true} />
        </div>
      </div>
    </Card>

    <!-- <Card
      href="/blog"
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title="Blog"
    /> -->

    <ThemeChangeCard />

    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <p class="text-xs">
        © {currentYear} · Crafted with ♥️ using <a
          class="text-red-500"
          href="https://astro.build/"
          target="_blank">Astro</a
        > by Me.
      </p>
    </Card>
  </main>
</Layout>